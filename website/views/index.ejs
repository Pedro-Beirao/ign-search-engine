<!DOCTYPE html>
<html>
<head>
<title>IGN Reviews Search</title>
<link type="text/css" rel="stylesheet" href="css/styles.css">
</head>
<body>
    <h1>IGN Review Search</h1>
    <form action="/" method="get">
        <input type="text" id="ftext" name="ftext" value="<%=ftext%>" placeholder="Search">
        <br><br>
        <label for="frat">Rating</label><br>
        <input type="number" id="fmin" name="fmin" min="1" max="10" value="<%=fmin%>" placeholder="1"> < 
        <input type="number" id="fmax" name="fmax" min="1" max="10" value="<%=fmax%>" placeholder="10">
        <br><br>
        <input id="submit" type="submit" value="Search">
    </form>
    <br>
    <div id="list">
        <%
        items.forEach(function(item)
        {
            console.log(item.Title);
        %>        
            <div class="item">
                <h2><%= item.Title %></h2>
                <h3><%= item.Subheader %></h3>
                <br>
                <h3><%= item.Subtitle %></h3>
                <div><%= item.Content %></div>
                <div class="score"><%= item.Score %></div>
            </div>
        <%
        }); 
        %>
    </div>
</body>
</html>